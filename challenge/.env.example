# ---------------------------------------------------------------------------
# Elo Saúde — modelo de variáveis de ambiente
# Copie para .env e preencha com valores locais. NUNCA versionar o .env.
# ---------------------------------------------------------------------------

# Produção (PostgreSQL): postgresql+psycopg://usuario:senha@host:5432/elo_saude
# Desenvolvimento local: sqlite:///./elo_saude.db
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/elo_saude

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-48-bytes

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=troque-por-uma-chave-fernet-gerada

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Usuário administrador criado no seed
ADMIN_EMAIL=admin@elo.saude
ADMIN_PASSWORD=troque-por-uma-senha-forte

BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# true apenas em desenvolvimento; em produção use HTTPS e COOKIE_SECURE=true
COOKIE_SECURE=false
CREATE_SCHEMA_ON_STARTUP=true

# Opcional no MVP (a notificação ao paciente é simulada)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_FROM_EMAIL=nao-responder@elo.saude
SMTP_PASSWORD=nao-usado-no-mvp
